# GEDI MODE — environment variables
#
# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local or real credentials.

# --- Supabase Realtime Presence (live "ON GEDI" counter) ---------------
# Optional: if these are absent, the app still runs and the live counter
# falls back to a static "GEDI LIVE" label instead of crashing or showing
# a fake number.
#
# 1. Create or select a project at https://supabase.com/dashboard.
# 2. Project Settings -> API -> "Project URL" -> NEXT_PUBLIC_SUPABASE_URL.
# 3. Project Settings -> API -> "anon public" / "publishable" key
#    -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. This key is safe for the
#    browser — it is NOT the service_role/secret key. Never put the
#    service_role key in a NEXT_PUBLIC_* variable or any client code.
# 4. Project Settings -> Realtime -> confirm Realtime is enabled for the
#    project (it is on by default for new projects).
# 5. Add both variables to your deployment platform's environment
#    variable settings (e.g. Vercel Project Settings -> Environment
#    Variables) in addition to your local .env.local.

# The Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The client-safe publishable ("anon public") key — never the secret/
# service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
